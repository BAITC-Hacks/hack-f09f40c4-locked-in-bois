# Copy to .env (gitignored — never commit real keys).
# The app works fully WITHOUT any key: LLM_PROVIDER=offline.
#
# LLM_PROVIDER is an ordered fallback list: offline | openai | nvidia | openai,nvidia
# Each provider accepts several comma-separated keys. They are tried in order;
# a key that fails (auth, rate limit, timeout) hands over to the next one,
# and if every key fails the deterministic offline template is returned.
LLM_PROVIDER=offline

OPENAI_API_KEYS=
OPENAI_MODEL=gpt-5-mini

# NVIDIA NIM (OpenAI-compatible endpoint)
NVIDIA_API_KEYS=
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
NVIDIA_MODEL=nvidia/nemotron-3-super-120b-a12b

# Seconds for the whole agent loop (all fallbacks together) before going offline
LLM_TIMEOUT=60
